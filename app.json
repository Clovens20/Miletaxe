{
  "expo": {
    "name": "MileTax",
    "slug": "miletax",
    "owner": "clovens2020",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "miletax",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#070807"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miletax.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MileTax utilise l'appareil photo pour photographier vos reçus et votre odomètre.",
        "NSPhotoLibraryUsageDescription": "MileTax accède à vos photos pour enregistrer vos reçus et relevés.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070807",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.miletax.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.miletax.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070807",
          "image": "./assets/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MileTax a besoin d'accéder à vos photos pour enregistrer vos reçus.",
          "cameraPermission": "MileTax a besoin de l'appareil photo pour photographier vos reçus et votre odomètre."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://miletaxe.com/legal/privacy",
      "termsUrl": "https://miletaxe.com/legal/terms",
      "router": {},
      "eas": {
        "projectId": "80acb571-5260-4b2a-afde-14c2e5e6ef9e"
      }
    }
  }
}
