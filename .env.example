EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Supabase Edge Function that runs receipt OCR/AI.
# When unset, photos are stored and the user enters amounts manually.
EXPO_PUBLIC_OCR_FUNCTION_NAME=extract-receipt
EXPO_PUBLIC_ODOMETER_OCR_FUNCTION_NAME=extract-odometer
EXPO_PUBLIC_DELETE_ACCOUNT_FUNCTION_NAME=delete-account
EXPO_PUBLIC_ADMIN_DELETE_FUNCTION_NAME=admin-delete-user

# Demo seed is disabled in the app. Use a real Supabase account.
EXPO_PUBLIC_UI_PREVIEW=false

# Edge Functions only (delete-account, admin-delete-user). NEVER use EXPO_PUBLIC_ for this key.
# Paste from Supabase > Project Settings > API > service_role.
# Hosted functions: npx supabase secrets set SUPABASE_SERVICE_ROLE_KEY=votre_cle
SUPABASE_SERVICE_ROLE_KEY=
